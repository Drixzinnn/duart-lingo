rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isTeacher() {
      return request.auth != null && request.auth.token.email == 'professor@duartlingo.app';
    }
    match /users/{uid} {
      // Quem está logado vê o ranking.
      allow read: if request.auth != null;
      // Cada aluno cria só o próprio perfil, começando do zero.
      allow create: if request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','xp','streak','done','hearts','created'])
        && request.resource.data.xp == 0
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 20;
      // Aluno só altera o próprio progresso, sem ganhar mais de 50 XP por gravação.
      allow update: if isTeacher() || (
        request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['xp','streak','done','hearts'])
        && request.resource.data.xp is int
        && request.resource.data.xp >= resource.data.xp
        && request.resource.data.xp - resource.data.xp <= 50
        && request.resource.data.done.size() <= 200);
      allow delete: if isTeacher();
    }
  }
}
